{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "rootDir": "./generated",
    "outDir": "./dist"
  },
  "include": ["generated/**/*"]
}
